rules_version = '2';

// IE-Photo Firestore Rules — role เก็บใน user doc (static app, ไม่มี custom claim)
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function roleOf(uid)  { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin()    { return isSignedIn() && roleOf(request.auth.uid) in ['admin','super_admin']; }
    function isSuper()    { return isSignedIn() && roleOf(request.auth.uid) == 'super_admin'; }

    // banned/{uid} คงอยู่แม้ user doc ถูกลบ → กัน self-heal สร้างบัญชีคืน
    // ใส่เฉพาะ write path (read ไม่ใส่ เพื่อคุมค่า read + เพดาน document-access)
    function notBanned()  { return !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function canWrite()   { return isSignedIn() && notBanned(); }

    // ── users ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn()
                       && request.auth.uid == uid
                       && request.resource.data.role == 'member'
                       && !exists(/databases/$(database)/documents/banned/$(uid));

      allow update: if
        // เจ้าของ — เฉพาะฟิลด์โปรไฟล์ (แตะ role / disabled / studentId / email ไม่ได้)
        (request.auth.uid == uid && notBanned()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['firstName','lastName','phone','profileImageUrl','profileCompleted',
               'pushSubscription','pushSubscriptions']))
        // แอดมิน — แก้ doc คนอื่นเท่านั้น, admin ธรรมดาห้ามแตะ super_admin ทั้งขาขึ้น/ขาลง
        || (isAdmin() && notBanned() && request.auth.uid != uid
            && (isSuper() || (resource.data.role != 'super_admin'
                              && request.resource.data.role != 'super_admin')));

      allow delete: if isAdmin() && notBanned()
                       && (isSuper() || resource.data.role != 'super_admin');
    }

    // ── banned (เจ้าของต้องอ่าน doc ตัวเองได้ ไม่งั้น client ตรวจการถูกระงับไม่ได้) ──
    match /banned/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && notBanned() && request.auth.uid != uid
                      && (isSuper()
                          || !exists(/databases/$(database)/documents/users/$(uid))
                          || roleOf(uid) != 'super_admin');
    }

    // ── equipments / studios ───────────────────────────────────
    match /equipments/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() && notBanned();
    }
    match /studios/{id} {
      allow read:  if true;
      allow write: if isAdmin() && notBanned();
    }

    // ── slots — ตารางล้วน ไม่มีข้อมูลส่วนตัว อ่านสาธารณะเพื่อให้ guest เช็คเวลาซ้อนได้ ──
    function validSlot() {
      let d = request.resource.data;
      let f = ['bookingId','itemId','itemName','bookingType','startAt','endAt','status'];
      return d.keys().hasOnly(f) && d.keys().hasAll(f)
             && d.bookingId is string && d.bookingId.size() > 0 && d.bookingId.size() <= 60
             && d.itemId    is string && d.itemId.size() > 0    && d.itemId.size() <= 60
             && d.itemName  is string && d.itemName.size() > 0  && d.itemName.size() <= 200
             && d.bookingType in ['equipment','studio']
             && d.startAt is timestamp && d.endAt is timestamp
             && d.endAt > d.startAt
             && d.startAt > request.time - duration.value(5,'m')
             && d.startAt < request.time + duration.value(90,'d')
             && d.endAt   < d.startAt + duration.value(7,'d')
             && d.status == 'pending';   // 'approved' ตั้งได้โดยแอดมินเท่านั้น
    }

    // Client สร้าง slot ได้เฉพาะพร้อม booking ใหม่ที่มีข้อมูลช่วงเวลาเดียวกันใน batch เดียวกัน
    // เพื่อกัน anonymous/public client สร้าง pending slot ปลอมมาบล็อกคิว
    function hasNewMatchingBooking(slotId) {
      let slot = request.resource.data;
      let bookingPath = /databases/$(database)/documents/bookings/$(slotId);
      return slot.bookingId == slotId
             && !exists(bookingPath)
             && existsAfter(bookingPath)
             && getAfter(bookingPath).data.bookingType == slot.bookingType
             && getAfter(bookingPath).data.itemId == slot.itemId
             && getAfter(bookingPath).data.itemName == slot.itemName
             && getAfter(bookingPath).data.startAt == slot.startAt
             && getAfter(bookingPath).data.endAt == slot.endAt
             && getAfter(bookingPath).data.status == 'pending';
    }

    match /slots/{id} {
      allow read:   if true;
      allow create: if validSlot() && hasNewMatchingBooking(id)
                       && (request.auth == null || notBanned());
      allow update, delete: if isAdmin() && notBanned();
    }

    // ── bookings ───────────────────────────────────────────────
    function validBookingCore(d) {
      return d.bookingType in ['equipment','studio']
             && d.itemId   is string && d.itemId.size() > 0   && d.itemId.size() <= 60
             && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
             && d.usageReason is string && d.usageReason.size() > 0 && d.usageReason.size() <= 500
             && d.userName  is string && d.userName.size() <= 100
             && d.userPhone is string && d.userPhone.size() <= 20
             && d.startAt is timestamp && d.endAt is timestamp
             && d.endAt > d.startAt
             && d.startAt > request.time - duration.value(5,'m')
             && d.startAt < request.time + duration.value(90,'d')
             && d.status == 'pending'
             && d.returnImageUrl == null;
    }

    function validMemberBooking() {
      let d = request.resource.data;
      return validBookingCore(d)
             && d.userId == request.auth.uid
             && d.endAt < d.startAt + duration.value(7,'d')
             && (d.formImageUrl == null
                 || (d.formImageUrl is string && d.formImageUrl.size() <= 650000));
    }

    function validGuestBooking() {
      let d = request.resource.data;
      return validBookingCore(d)
             && d.bookingType == 'studio'
             && d.userId == null
             && exists(/databases/$(database)/documents/studios/$(d.itemId))
             && d.guestName  is string && d.guestName.size() > 0 && d.guestName.size() <= 100
             && d.guestEmail is string && d.guestEmail.matches('.+@.+[.].+') && d.guestEmail.size() <= 120
             && d.userName.size() > 0
             && d.userPhone.size() >= 9
             && d.endAt < d.startAt + duration.value(24,'h')
             && d.formImageUrl == null
             && d.responsibleUserId == null
             && d.consentToken == null;
    }

    function onlyReturnChanged() {
      return resource.data.bookingType == 'equipment'
             && request.time >= resource.data.startAt
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returnImageUrl'])
             && request.resource.data.status == 'pending_return'
             && resource.data.status == 'approved'
             && request.resource.data.returnImageUrl is string
             && request.resource.data.returnImageUrl.size() <= 650000;
    }

    match /bookings/{id} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if (canWrite() && validMemberBooking())
                       || (request.auth == null && validGuestBooking());
      allow update: if (isAdmin() && notBanned())
                       || (canWrite() && resource.data.userId == request.auth.uid && onlyReturnChanged());
      allow delete: if isAdmin() && notBanned();
    }

    // ── tasks ──────────────────────────────────────────────────
    match /tasks/{id} {
      allow read: if isSignedIn() && (isAdmin()
                     || resource.data.assignedToId == request.auth.uid
                     || resource.data.assignedById == request.auth.uid);
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned())
                       || (canWrite() && resource.data.assignedToId == request.auth.uid
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                           && request.resource.data.status in ['pending','in_progress','completed']);
    }

    // ── feeds ──────────────────────────────────────────────────
    function likeDeltaOk() {
      let before = resource.data;
      let after  = request.resource.data;
      let uid    = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['likedBy','likeCount'])
             && after.likeCount >= 0
             && (
                  ( after.likeCount == before.likeCount + 1
                    && !(uid in before.likedBy) && (uid in after.likedBy)
                    && after.likedBy.size() == before.likedBy.size() + 1
                    && after.likedBy.hasAll(before.likedBy)
                    && after.likedBy.hasOnly(before.likedBy.concat([uid])) )
               || ( after.likeCount == before.likeCount - 1
                    && (uid in before.likedBy) && !(uid in after.likedBy)
                    && after.likedBy.size() == before.likedBy.size() - 1
                    && before.likedBy.hasAll(after.likedBy) )
             );
    }

    match /feeds/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned()) || (canWrite() && likeDeltaOk());
    }
  }
}
