rules_version = '2';

// IE-Photo Firestore Rules — role เก็บใน user doc (static app, ไม่มี custom claim)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function roleOf(uid)  { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin()    { return isSignedIn() && roleOf(request.auth.uid) in ['admin', 'super_admin']; }

    function onlyLikeChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount']);
    }
    function onlyReturnChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnImageUrl'])
             && request.resource.data.status == 'pending_return';
    }

    // ── users ────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                       && request.resource.data.role == 'member';
      // owner แก้ profile ตัวเอง (ห้ามแก้ role เอง) / admin แก้ได้ทุกอย่าง (เปลี่ยน role)
      allow update: if isAdmin()
                       || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ── equipments ───────────────────────────────────────────
    match /equipments/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── studios (อ่านสาธารณะ) ────────────────────────────────
    match /studios/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // จองสตูดิโอโดยไม่ล็อกอิน (หน้า /book) — อนุญาตแคบที่สุดเท่าที่ทำได้
    // อ่านไม่ได้ / แก้ไม่ได้ / ลบไม่ได้ สร้างได้อย่างเดียว และต้องผ่านเงื่อนไขทุกข้อ
    function isValidGuestBooking() {
      let d = request.resource.data;
      return d.bookingType == 'studio'
             && d.status == 'pending'
             && d.userId == null
             && exists(/databases/$(database)/documents/studios/$(d.itemId))
             && d.guestName is string  && d.guestName.size() > 0 && d.guestName.size() <= 100
             && d.guestEmail is string && d.guestEmail.matches('.+@.+[.].+') && d.guestEmail.size() <= 120
             && d.userName is string   && d.userName.size() > 0 && d.userName.size() <= 100
             && d.userPhone is string  && d.userPhone.size() >= 9 && d.userPhone.size() <= 20
             && d.usageReason is string && d.usageReason.size() > 0 && d.usageReason.size() <= 500
             && d.startAt is timestamp && d.endAt is timestamp
             && d.endAt > d.startAt
             && d.startAt > request.time - duration.value(5, 'm')
             // กันยัดรูป base64 ขนาดใหญ่เข้ามาทาง guest form
             && d.formImageUrl == null
             && d.returnImageUrl == null
             && d.responsibleUserId == null
             && d.consentToken == null;
    }

    // ── bookings ─────────────────────────────────────────────
    match /bookings/{id} {
      allow read:   if isSignedIn();
      allow create: if (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.status == 'pending')
                       || (request.auth == null && isValidGuestBooking());
      allow update: if isAdmin()
                       || (isSignedIn() && resource.data.userId == request.auth.uid && onlyReturnChanged());
      allow delete: if isAdmin();
    }

    // ── tasks ────────────────────────────────────────────────
    match /tasks/{id} {
      allow read:           if isSignedIn() && (isAdmin()
                              || resource.data.assignedToId == request.auth.uid
                              || resource.data.assignedById == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update:         if isAdmin()
                              || (isSignedIn() && resource.data.assignedToId == request.auth.uid
                                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // ── feeds ────────────────────────────────────────────────
    match /feeds/{id} {
      allow read:           if isSignedIn();
      allow create, delete: if isAdmin();
      allow update:         if isAdmin() || (isSignedIn() && onlyLikeChanged());
    }
  }
}
