rules_version = '2';

// IE-Photo Firestore Rules — role เก็บใน user doc (static app, ไม่มี custom claim)
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function roleOf(uid)  { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin()    { return isSignedIn() && roleOf(request.auth.uid) in ['admin','super_admin']; }
    function isSuper()    { return isSignedIn() && roleOf(request.auth.uid) == 'super_admin'; }

    // banned/{uid} คงอยู่แม้ user doc ถูกลบ → กัน self-heal สร้างบัญชีคืน
    // ใส่เฉพาะ write path (read ไม่ใส่ เพื่อคุมค่า read + เพดาน document-access)
    function notBanned()  { return !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function canWrite()   { return isSignedIn() && notBanned(); }

    // ── settings/app — อ่านสาธารณะ (หน้า /book, /form ต้องใช้), เขียนเฉพาะแอดมิน ──
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin() && notBanned();
    }

    // ── secrets/{id} — ค่าตั้งค่าที่ห้ามหลุดสู่สาธารณะ (คีย์ AI ฯลฯ) ──
    // ต่างจาก settings/app ตรงที่ settings อ่านได้ทุกคน (หน้า /book ต้องใช้)
    // ส่วนนี้จำกัดเฉพาะกรรมการ — คีย์จึงไม่ถูกฝังในไฟล์ JS ที่ใครก็โหลดได้
    match /secrets/{id} {
      allow read, write: if isAdmin() && notBanned();
    }

    // ── aiChats/{id} — ประวัติคุยกับผู้ช่วย ─────────────────────
    // เก็บบทสนทนาเรื่องการบริหารคน จึงจำกัดที่กรรมการเหมือนตัวผู้ช่วยเอง
    match /aiChats/{id} {
      allow read, write: if isAdmin() && notBanned();
    }

    // ── mailQueue/{id} — คิวอีเมลรอส่ง ──────────────────────────
    // แอปเป็นแค่คนหย่อนงานลงคิว ตัวส่งจริงคือ Cloudflare Worker ที่อ่านด้วย
    // สิทธิ์ระดับเซิร์ฟเวอร์ — ฝั่งเว็บจึงให้เขียนได้แต่ไม่ให้แก้ของที่ส่งไปแล้ว
    match /mailQueue/{id} {
      allow read:   if isAdmin();
      allow create: if canWrite() && validMail();
      allow update, delete: if isAdmin() && notBanned();
    }

    function validMail() {
      let d = request.resource.data;
      return d.to is string && d.to.matches('.+@.+[.].+') && d.to.size() <= 200
             && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 200
             && d.body is string && d.body.size() > 0 && d.body.size() <= 4000
             && d.status == 'queued'
             && d.kind is string && d.kind.size() <= 40;
    }

    // ── users ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn()
                       && request.auth.uid == uid
                       && request.resource.data.role == 'member'
                       && !exists(/databases/$(database)/documents/banned/$(uid));

      allow update: if
        // เจ้าของ — เฉพาะฟิลด์โปรไฟล์ (แตะ role / disabled / studentId / email ไม่ได้)
        (request.auth.uid == uid && notBanned()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['firstName','lastName','nickname','phone','skills','profileImageUrl',
               'profileCompleted','pushSubscription','pushSubscriptions','memberCode'])
         // memberCode = รหัสใน QR ประจำตัว ตั้งได้ครั้งเดียว เจ้าของแก้เองภายหลังไม่ได้
         // (ถ้าทำหลุด ต้องให้แอดมินออกรหัสใหม่ให้ ผ่าน branch ของ admin ข้างล่าง)
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCode'])
             || (!('memberCode' in resource.data)
                 && request.resource.data.memberCode is string
                 && request.resource.data.memberCode.size() >= 6
                 && request.resource.data.memberCode.size() <= 20)))
        // ประธาน — ตั้ง "ยศในชุมนุม" ของตัวเองได้ (ฟิลด์เดียว ไม่แตะสิทธิ์)
        || (isSuper() && notBanned() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title']))
        // แอดมิน — แก้ doc คนอื่นเท่านั้น, admin ธรรมดาห้ามแตะ super_admin ทั้งขาขึ้น/ขาลง
        || (isAdmin() && notBanned() && request.auth.uid != uid
            && (isSuper() || (resource.data.role != 'super_admin'
                              && request.resource.data.role != 'super_admin')))
        // แอดมินแก้ "ข้อมูลส่วนตัว" ของใครก็ได้ (รวมประธาน) — เฉพาะฟิลด์ที่ไม่ใช่สิทธิ์
        // hasOnly คุมให้แตะได้แค่ชื่อ/ชื่อเล่น/เบอร์/ความถนัด/รูป role กับ disabled
        // อยู่นอกชุดจึงเปลี่ยนไม่ได้ = แก้ข้อมูลได้แต่ยึดบัญชีประธานไม่ได้
        || (isAdmin() && notBanned() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['firstName','lastName','nickname','phone','skills','profileImageUrl']));

      allow delete: if isAdmin() && notBanned()
                       && (isSuper() || resource.data.role != 'super_admin');
    }

    // ── banned (เจ้าของต้องอ่าน doc ตัวเองได้ ไม่งั้น client ตรวจการถูกระงับไม่ได้) ──
    match /banned/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && notBanned() && request.auth.uid != uid
                      && (isSuper()
                          || !exists(/databases/$(database)/documents/users/$(uid))
                          || roleOf(uid) != 'super_admin');
    }

    // ── crew/{uid} — เครื่องหมายว่าบัญชีนี้เป็นทีมงาน ─────────────
    // จำเป็นเพราะ photographers/{id} ใช้ id สุ่ม แล้วเก็บ uid ไว้ในฟิลด์
    // rules ค้นด้วยฟิลด์ไม่ได้ ต้องมี doc ที่ตั้ง id = uid ให้ exists() เช็คตรง ๆ
    function isCrew() {
      return isSignedIn() && exists(/databases/$(database)/documents/crew/$(request.auth.uid));
    }

    match /crew/{uid} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() && notBanned();
    }

    // ── availability/{uid} — วันที่ไม่ว่างของทีมงาน ──────────────
    // เจ้าของแก้ของตัวเองได้ · กรรมการอ่านได้ทุกคน (ต้องเห็นก่อนสั่งงาน)
    // เก็บแค่วันที่ ไม่มีข้อมูลส่วนตัว
    function validAvailability() {
      let d = request.resource.data;
      return d.keys().hasOnly(['busyDates','notes','updatedAt'])
             && d.busyDates is list
             && d.busyDates.size() <= 400;   // ~1 ปี เผื่อพอ กันเขียนถล่ม
    }

    match /availability/{uid} {
      allow read: if isSignedIn();
      allow write: if notBanned()
                      && (request.auth.uid == uid || isAdmin())
                      && validAvailability();
    }

    // ── equipments / studios / photographers ───────────────────
    match /equipments/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() && notBanned();
    }
    match /studios/{id} {
      allow read:  if true;
      allow write: if isAdmin() && notBanned();
    }
    // ทีมตากล้อง — อ่านสาธารณะเพื่อให้คนนอกเลือกก่อนจอง
    // (ห้ามเก็บเบอร์/อีเมลส่วนตัวใน doc นี้ เพราะอ่านได้ทุกคน)
    match /photographers/{id} {
      allow read:  if true;
      allow write: if isAdmin() && notBanned();
    }

    // ── slots — ตารางล้วน ไม่มีข้อมูลส่วนตัว อ่านสาธารณะเพื่อให้ guest เช็คเวลาซ้อนได้ ──
    function slotShape(d) {
      let f = ['bookingId','itemId','itemName','bookingType','startAt','endAt','status'];
      return d.keys().hasOnly(f) && d.keys().hasAll(f)
             && d.bookingId is string && d.bookingId.size() > 0 && d.bookingId.size() <= 60
             && d.itemId    is string && d.itemId.size() > 0    && d.itemId.size() <= 60
             && d.itemName  is string && d.itemName.size() > 0  && d.itemName.size() <= 200
             && d.bookingType in ['equipment','studio','photographer']
             && d.startAt is timestamp && d.endAt is timestamp
             && d.endAt > d.startAt
             && d.startAt > request.time - duration.value(5,'m')
             && d.startAt < request.time + duration.value(365,'d');
    }

    function validSlot() {
      let d = request.resource.data;
      return slotShape(d)
             && d.endAt < d.startAt + duration.value(7,'d')
             && d.status == 'pending';   // 'approved' ตั้งได้โดยแอดมินเท่านั้น
    }

    // แอดมินมอบหมาย = ยืนยันคิวทันที จึงสร้าง slot สถานะ approved ได้เลย
    function validAdminSlot() {
      let d = request.resource.data;
      return isAdmin() && notBanned()
             && slotShape(d)
             && d.endAt < d.startAt + duration.value(30,'d')
             && d.status in ['pending','approved'];
    }

    match /slots/{id} {
      allow read:   if true;
      allow create: if validAdminSlot()
                       || (validSlot() && (request.auth == null || notBanned()));
      allow update, delete: if isAdmin() && notBanned();
    }

    // ── bookings ───────────────────────────────────────────────
    // โครงข้อมูลการจอง — ยังไม่รวมสถานะ (คนทั่วไปสร้างได้แค่ 'pending')
    function bookingShape(d) {
      return d.bookingType in ['equipment','studio','photographer']
             && d.itemId   is string && d.itemId.size() > 0   && d.itemId.size() <= 60
             && d.itemName is string && d.itemName.size() > 0 && d.itemName.size() <= 200
             && d.usageReason is string && d.usageReason.size() > 0 && d.usageReason.size() <= 500
             && d.userName  is string && d.userName.size() <= 100
             && d.userPhone is string && d.userPhone.size() <= 20
             && d.startAt is timestamp && d.endAt is timestamp
             && d.endAt > d.startAt
             && d.startAt > request.time - duration.value(5,'m')
             && d.startAt < request.time + duration.value(365,'d')
             && d.returnImageUrl == null
             // ฟิลด์งานตากล้อง — ไม่บังคับต้องมี แต่ถ้ามีต้องอยู่ในกรอบ
             && (!('location' in d) || d.location == null
                 || (d.location is string && d.location.size() <= 200))
             && (!('crewSize' in d) || d.crewSize == null
                 || (d.crewSize is int && d.crewSize >= 1 && d.crewSize <= 20))
             && (!('usageType' in d) || d.usageType == null
                 || (d.usageType is string && d.usageType.size() <= 120));
    }

    function validBookingCore(d) {
      return bookingShape(d) && d.status == 'pending';
    }

    // แอดมินมอบหมายงาน — ระบุผู้รับผิดชอบและอนุมัติทันทีได้ในขั้นตอนเดียว
    // (งานที่กรรมการสั่งเองไม่ต้องรออนุมัติซ้ำ) และจองแทนคนอื่นได้
    function validAdminBooking() {
      let d = request.resource.data;
      return isAdmin() && notBanned()
             && bookingShape(d)
             && d.status in ['pending','approved']
             && (!('assigneeIds' in d) || d.assigneeIds == null
                 || (d.assigneeIds is list && d.assigneeIds.size() <= 20))
             && d.endAt < d.startAt + duration.value(30,'d')
             && (d.formImageUrl == null
                 || (d.formImageUrl is string && d.formImageUrl.size() <= 900000));
    }

    function validMemberBooking() {
      let d = request.resource.data;
      return validBookingCore(d)
             && d.userId == request.auth.uid
             && d.endAt < d.startAt + duration.value(7,'d')
             && (d.formImageUrl == null
                 || (d.formImageUrl is string && d.formImageUrl.size() <= 900000));
    }

    function validGuestBooking() {
      let d = request.resource.data;
      return validBookingCore(d)
             && d.bookingType in ['studio','photographer']
             && d.userId == null
             && (d.bookingType == 'studio'
                 ? exists(/databases/$(database)/documents/studios/$(d.itemId))
                 : exists(/databases/$(database)/documents/photographers/$(d.itemId)))
             && d.guestName  is string && d.guestName.size() > 0 && d.guestName.size() <= 100
             && d.guestEmail is string && d.guestEmail.matches('.+@.+[.].+') && d.guestEmail.size() <= 120
             && d.userName.size() > 0
             && d.userPhone.size() >= 9
             && d.endAt < d.startAt + duration.value(24,'h')
             && d.formImageUrl == null
             && d.responsibleUserId == null
             && d.consentToken == null;
    }

    // เจ้าของยกเลิกการจองของตัวเองได้ ถ้ายังไม่เริ่มใช้จริง
    // (รออนุมัติ = ยกเลิกได้เสมอ · อนุมัติแล้วแต่ยังไม่ถึงเวลา = ยกเลิกได้)
    // อนุมัติแล้วและเลยเวลาเริ่มไปแล้ว = ของอยู่ในมือแล้ว ต้องคืน ไม่ใช่ยกเลิก
    function ownerCancel() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
             && request.resource.data.status == 'cancelled'
             && (resource.data.status == 'pending'
                 || (resource.data.status == 'approved' && resource.data.startAt > request.time));
    }

    function onlyReturnChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returnImageUrl'])
             && request.resource.data.status == 'pending_return'
             && resource.data.status == 'approved';
    }

    // ทีมงานเข้า/ออกจากงานเองได้ — แตะได้แค่ assigneeIds และเฉพาะ uid ตัวเอง
    // (รูปแบบเดียวกับการกดไลก์ในฟีด: ตรวจ delta ของ array ไม่ใช่ค่าปลายทาง)
    // 1 งานมีได้หลายคน · 1 คนรับได้หลายงาน — ไม่มีเพดานทั้งสองทาง
    function claimJob() {
      let before = resource.data;
      let after  = request.resource.data;
      let uid    = request.auth.uid;
      let beforeIds = ('assigneeIds' in before) ? before.assigneeIds : [];
      return isCrew() && notBanned()
             && before.bookingType == 'photographer'
             && before.status == 'approved'
             && after.diff(before).affectedKeys().hasOnly(['assigneeIds'])
             && after.assigneeIds is list
             && after.assigneeIds.size() <= 20
             && (
                  // เข้าร่วมงาน — เพิ่มได้เฉพาะ uid ตัวเอง และต้องยังไม่ได้อยู่ในงาน
                  ( !(uid in beforeIds)
                    && (uid in after.assigneeIds)
                    && after.assigneeIds.hasAll(beforeIds)
                    && after.assigneeIds.size() == beforeIds.size() + 1 )
                  // ถอนตัว — ถอดได้เฉพาะตัวเอง คนอื่นต้องอยู่ครบเหมือนเดิม
               || ( (uid in beforeIds)
                    && !(uid in after.assigneeIds)
                    && beforeIds.hasAll(after.assigneeIds)
                    && after.assigneeIds.size() == beforeIds.size() - 1 )
             );
    }

    match /bookings/{id} {
      allow read:   if isAdmin()
                       || (isSignedIn() && resource.data.userId == request.auth.uid)
                       // ทีมงานเห็นเฉพาะงานตากล้องที่อนุมัติแล้ว (ต้องใช้ชื่อ/เบอร์ลูกค้าไปทำงาน)
                       || (isCrew() && resource.data.bookingType == 'photographer'
                           && resource.data.status in ['approved','pending_return','returned']);
      allow create: if validAdminBooking()
                       || (canWrite() && validMemberBooking())
                       || (request.auth == null && validGuestBooking());
      allow update: if (isAdmin() && notBanned())
                       || (canWrite() && resource.data.userId == request.auth.uid
                           && (onlyReturnChanged() || ownerCancel()))
                       || claimJob();
      allow delete: if isAdmin() && notBanned();
    }

    // ── tasks ──────────────────────────────────────────────────
    match /tasks/{id} {
      allow read: if isSignedIn() && (isAdmin()
                     || resource.data.assignedToId == request.auth.uid
                     || resource.data.assignedById == request.auth.uid);
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned())
                       || (canWrite() && resource.data.assignedToId == request.auth.uid
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                           && request.resource.data.status in ['pending','in_progress','completed']);
    }

    // ── feeds ──────────────────────────────────────────────────
    function likeDeltaOk() {
      let before = resource.data;
      let after  = request.resource.data;
      let uid    = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly(['likedBy','likeCount'])
             && (
                  ( after.likeCount == before.likeCount + 1
                    && !(uid in before.likedBy) && (uid in after.likedBy)
                    && after.likedBy.hasAll(before.likedBy)
                    && after.likedBy.hasOnly(before.likedBy.concat([uid])) )
               || ( after.likeCount == before.likeCount - 1
                    && (uid in before.likedBy) && !(uid in after.likedBy)
                    && before.likedBy.hasAll(after.likedBy) )
             );
    }

    match /feeds/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned()) || (canWrite() && likeDeltaOk());
    }

    // ── forms — ฟอร์มที่แอดมินสร้างเอง ─────────────────────────
    // อ่านสาธารณะ: หน้า /form/?id=… ต้องอ่าน schema ได้แม้ยังไม่ล็อกอิน
    // เขียน: แอดมินเท่านั้น ยกเว้น responseCount ที่ผู้ส่งฟอร์มบวก 1 ได้
    function onlyResponseCountIncremented() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount'])
             && request.resource.data.responseCount == resource.data.responseCount + 1;
    }

    match /forms/{id} {
      allow read:   if true;
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned())
                       || (resource.data.active == true
                           && onlyResponseCountIncremented()
                           && (request.auth == null
                               ? resource.data.allowGuest == true
                               : notBanned()));
    }

    // ── formResponses — คำตอบฟอร์ม ─────────────────────────────
    // อ่านได้เฉพาะแอดมินกับเจ้าของคำตอบ (คนนอกส่งแล้วอ่านกลับไม่ได้ กันดูดข้อมูลคนอื่น)
    function validFormResponse() {
      let d = request.resource.data;
      let f = ['formId','formTitle','values','userId','submitterName','submitterContact','bookingId','createdAt'];
      let form = get(/databases/$(database)/documents/forms/$(d.formId)).data;
      return d.keys().hasOnly(f) && d.keys().hasAll(f)
             && d.formId is string && d.formId.size() > 0 && d.formId.size() <= 60
             && d.formTitle is string && d.formTitle.size() <= 200
             && d.values is map && d.values.size() <= 60
             && d.submitterName is string && d.submitterName.size() > 0 && d.submitterName.size() <= 120
             && d.submitterContact is string && d.submitterContact.size() <= 160
             && (d.bookingId == null || (d.bookingId is string && d.bookingId.size() <= 60))
             // ฟอร์มต้องเปิดรับคำตอบอยู่จริง และคนนอกส่งได้เฉพาะฟอร์มที่อนุญาต
             && form.active == true
             && (request.auth == null
                 ? (d.userId == null && form.allowGuest == true)
                 : d.userId == request.auth.uid);
    }

    match /formResponses/{id} {
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if validFormResponse() && (request.auth == null || notBanned());
      allow update, delete: if isAdmin() && notBanned();
    }

    // ── deliveries — ส่งงาน/ลิงก์ NAS ──────────────────────────
    // ลิงก์เป็นข้อมูลอ่อนไหว: อ่านได้เฉพาะแอดมิน / ลูกค้าเจ้าของงาน / ทีมงานที่รับผิดชอบ
    // ทีมงานของ "งานส่งไฟล์" — รับผิดชอบตรง ๆ หรือรับผิดชอบใบจองที่ผูกกันอยู่
    // (งานถ่ายกับงานส่งไฟล์เป็นงานเดียวกัน — สิทธิ์จึงไหลมาจากใบจองต้นทาง
    //  ไม่ต้อง sync assigneeIds สองที่ให้ตรงกันตลอดเวลา)
    function inDelivery(d) {
      return d.assignedToId == request.auth.uid
             || (('assigneeIds' in d) && (request.auth.uid in d.assigneeIds))
             || (d.bookingId != null
                 && exists(/databases/$(database)/documents/bookings/$(d.bookingId))
                 && ('assigneeIds' in get(/databases/$(database)/documents/bookings/$(d.bookingId)).data)
                 && (request.auth.uid in get(/databases/$(database)/documents/bookings/$(d.bookingId)).data.assigneeIds));
    }

    match /deliveries/{id} {
      allow read: if isSignedIn() && (isAdmin()
                     || resource.data.customerUserId == request.auth.uid
                     || inDelivery(resource.data));
      allow create, delete: if isAdmin() && notBanned();
      allow update: if (isAdmin() && notBanned())
                       // ทีมงานที่รับผิดชอบ แจ้งได้แค่ว่า "อัปไฟล์แล้ว" — แตะลิงก์ไม่ได้
                       || (canWrite()
                           && inDelivery(resource.data)
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
                           && resource.data.status == 'awaiting_upload'
                           && request.resource.data.status == 'uploaded');
    }
  }
}
