# ─── Firebase Client SDK (ฝั่ง browser) ───
# ค่าจริงของโปรเจกต์ iephoto — ปลอดภัยที่จะ commit เพราะเปิดเผยอยู่แล้วในเว็บที่ deploy
# (ความปลอดภัยจริงคุมด้วย Firestore Security Rules ไม่ใช่การซ่อนค่าพวกนี้)
# ทำ UI/ทดสอบหน้าเว็บ ใช้แค่ส่วนนี้ก็พอ ไม่ต้องขอ Admin key จากใคร
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBNkiFvkivKrljHpoTKFPf-QoihW0U9YQU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=iephoto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=iephoto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=iephoto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=168997124320
NEXT_PUBLIC_FIREBASE_APP_ID=1:168997124320:web:3427eccc6fbe24f25b3885
# database เป็น named database ชื่อ "default" (ไม่ใช่ "(default)")
NEXT_PUBLIC_FIREBASE_DATABASE_ID=default

# ─── Firebase Admin SDK (ฝั่ง server — ความลับจริง ห้าม commit) ───
# ⚠️ ไม่จำเป็นสำหรับงาน UI — ใช้เฉพาะ scripts/*.cjs (seed, set-role, migration ฯลฯ)
# ถ้าจำเป็นต้องใช้ ขอไฟล์ service account จากเจ้าของโปรเจกต์โดยตรง (ห้ามส่งผ่าน git)
FIREBASE_PROJECT_ID=iephoto
FIREBASE_DATABASE_ID=default
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ─── Email (optional) ───
RESEND_API_KEY=

# ─── Web Push (ไม่ใช่ความลับ — VAPID public key ต้องฝังในหน้าเว็บอยู่แล้ว) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLq7q2saWxdy3tI_0aAaC9IR-reqRW2rI0egj3-E6y4fI7tl-KAh2MYief74UHTWW1ni7G7cBG2NUL7jO4sxmiw
# private key เป็นความลับจริง — ใช้เฉพาะ scripts/send-notifications.cjs เท่านั้น ไม่ต้องมีก็ทำ UI ได้
VAPID_PRIVATE_KEY=""
